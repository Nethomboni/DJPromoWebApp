@model IEnumerable<Venue>
@{ ViewData["Title"] = "Venues"; }
<h1>Venues</h1>
<p><a class="btn btn-primary" asp-action="Create">Add Venue</a></p>
<table class="table table-striped bg-white">
    <thead><tr><th>@Html.DisplayNameFor(m => m.Name)</th><th>@Html.DisplayNameFor(m => m.Address)</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Address</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.VenueID">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.VenueID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
