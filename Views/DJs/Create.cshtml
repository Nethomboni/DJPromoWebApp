@model DJ
@{ ViewData["Title"] = "Add DJ"; }
<h1>Add DJ</h1>
<form asp-action="Create" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="StageName" class="form-label"></label>
        <input asp-for="StageName" class="form-control" />
        <span asp-validation-for="StageName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
