@model IEnumerable<Gig>
@{ ViewData["Title"] = "Gigs"; }
<h1>Gigs</h1>
<p><a class="btn btn-primary" asp-action="Create">Add Gig</a></p>
<table class="table table-striped bg-white">
    <thead>
        <tr><th>DJ</th><th>Venue</th><th>Date</th><th>Time</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.DJ.StageName</td>
            <td>@item.Venue.Name</td>
            <td>@item.Date.ToString("dd MMM yyyy")</td>
            <td>@item.Time.ToString(@"hh\:mm")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.GigID">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.GigID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
