<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DJPromo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">DJPromo</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Gigs" asp-action="Index">Gigs</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="DJs" asp-action="Index">DJs</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Venues" asp-action="Index">Venues</a></li>
            </ul>
        </div>
    </nav>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="text-center text-muted py-3 border-top">&copy; @DateTime.Now.Year DJPromoWebApp</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
